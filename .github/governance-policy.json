{
  "required_status_checks": {
    "strict": true,
    "contexts": [
      "hygiene (repo lint)",
      "lint",
      "pytest (py3.10)",
      "pytest (py3.11)",
      "pytest (py3.12)",
      "pytest (py3.13)",
      "secret scanning",
      "dependency audit",
      "forbidden-path test"
    ]
  },
  "required_pull_request_reviews": true,
  "required_linear_history": true,
  "allow_force_pushes": false,
  "allow_deletions": false
}
