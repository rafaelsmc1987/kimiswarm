            "text": "{\"agents\":[{\"id\":\"1a00e62c-bc32-8685-8000-0f90c15cb5a8\", \"index\":43, \"name\":\"Louis\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/59.png\", \"motto\":\"I approach every task as if painting a masterpiece\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Converter relatório final para DOCX\", \"type\":\"coder\"}, {\"id\":\"1a00e553-5752-83e2-8000-0f9062685e92\", \"index\":42, \"name\":\"Reid\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/58.png\", \"motto\":\"Learn to leverage others' strengths—don't take everything on yourself\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Revisar sumário e blueprint\", \"type\":\"reviewer\"}, {\"id\":\"1a00e279-3c92-8129-8000-0f905db31565\", \"index\":41, \"name\":\"Gray\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/57.png\", \"motto\":\"Work with full focus\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Reaplicar correções sec07–sec18\", \"type\":\"escritor_tecnico_fsearch\"}, {\"id\":\"1a00e279-3ba2-88bd-8000-0f9074e51636\", \"index\":40, \"name\":\"Faquet\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/56.png\", \"motto\":\"Being seen changes behavior\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Reaplicar correções sec00–sec06\", \"type\":\"escritor_tecnico_fsearch\"}, {\"id\":\"1a00e17c-b8e2-8745-8000-0f90dfb8c9bf\", \"index\":39, \"name\":\"Dewitt\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/55.png\", \"motto\":\"Learning by doing\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Editor de transições global\", \"type\":\"reviewer\"}, {\"id\":\"1a00e0ca-8ec2-81d5-8000-0f90801312be\", \"index\":38, \"name\":\"Picasso\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/54.png\", \"motto\":\"Inspiration exists, but it has to find you working\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Corrigir sec16, sec18 e normalizar citações\", \"type\":\"general\"}, {\"id\":\"1a00e0ca-8de2-8e9b-8000-0f900d17315b\", \"index\":37, \"name\":\"Marlow\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/49.png\", \"motto\":\"The most certain way to succeed is always to try just one more time\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Corrigir sec07–sec12\", \"type\":\"escritor_tecnico_fsearch\"}, {\"id\":\"1a00e0ca-8ce2-802c-8000-0f90bce20a00\", \"index\":36, \"name\":\"Dru\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/46.png\", \"motto\":\"Managing time is managing everything\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Corrigir sec00, sec01, sec03\", \"type\":\"escritor_tecnico_fsearch\"}, {\"id\":\"1a00e0ca-8b42-8171-8000-0f9086966131\", \"index\":35, \"name\":\"Manco\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/45.png\", \"motto\":\"People face trade-offs\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Corrigir sec04 e sec05\", \"type\":\"escritor_tecnico_fsearch\"}, {\"id\":\"1a00df9d-8a52-8a72-8000-0f90851abcfc\", \"index\":34, \"name\":\"Noah\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/44.png\", \"motto\":\"Focus on high-value work\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Editar seção 12 e apêndices\", \"type\":\"reviewer\"}, {\"id\":\"1a00df9d-8912-87f6-8000-0f9082fd38e3\", \"index\":33, \"name\":\"Shannon\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/43.png\", \"motto\":\"Information is the bridge between chaos and order\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Editar seções 09–11\", \"type\":\"reviewer\"}, {\"id\":\"1a00df9d-87d2-8c1f-8000-0f90c0b02a41\", \"index\":32, \"name\":\"Heller\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/42.png\", \"motto\":\"What is real is rational\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Editar seções 06–08\", \"type\":\"reviewer\"}, {\"id\":\"1a00df9d-8662-8097-8000-0f90b7079dfc\", \"index\":31, \"name\":\"Jane\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/41.png\", \"motto\":\"Collaboration turns individual limits into shared strength\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Editar seções 03–05\", \"type\":\"reviewer\"}, {\"id\":\"1a00df9d-8542-8eb1-8000-0f90d7ad03f0\", \"index\":30, \"name\":\"Kat\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/40.png\", \"motto\":\"Aim true\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Editar seções 00–02\", \"type\":\"reviewer\"}, {\"id\":\"1a00df6b-7222-8a53-8000-0f90568036cf\", \"index\":29, \"name\":\"Summer\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/39.png\", \"motto\":\"Efficiency is the soul of doing things well\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Escrever Sumário Executivo\", \"type\":\"escritor_tecnico_fsearch\"}, {\"id\":\"1a00df02-b0c2-8c12-8000-0f90b8e6d901\", \"index\":28, \"name\":\"Wu\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/38.png\", \"motto\":\"The universe doesn't care about our intuition\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Escrever Cap. 12 (Blueprint)\", \"type\":\"escritor_tecnico_fsearch\"}, {\"id\":\"1a00ddb9-f272-8d01-8000-0f9092fd7eeb\", \"index\":27, \"name\":\"Lovel\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/37.png\", \"motto\":\"I shall cross a frontier that no one has yet tried to pass\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Escrever Apêndice E (glossário)\", \"type\":\"escritor_tecnico_fsearch\"}, {\"id\":\"1a00ddb9-f102-8b4e-8000-0f9007f4fb3a\", \"index\":26, \"name\":\"Quentin\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/36.png\", \"motto\":\"Busy with a method, you'll double your output\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Escrever Apêndice D (tabelas consolidadas)\", \"type\":\"escritor_tecnico_fsearch\"}, {\"id\":\"1a00ddb9-f042-8f3c-8000-0f9072942111\", \"index\":25, \"name\":\"Joker\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/35.png\", \"motto\":\"While other