            "text": "{\"agents\":[{\"id\":\"1a00e62c-bc32-8685-8000-0f90c15cb5a8\", \"index\":43, \"name\":\"Louis\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/59.png\", \"motto\":\"I approach every task as if painting a masterpiece\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Converter relatório final para DOCX\", \"type\":\"coder\"}, {\"id\":\"1a00e553-5752-83e2-8000-0f9062685e92\", \"index\":42, \"name\":\"Reid\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/58.png\", \"motto\":\"Learn to leverage others' strengths—don't take everything on yourself\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Revisar sumário e blueprint\", \"type\":\"reviewer\"}, {\"id\":\"1a00e279-3c92-8129-8000-0f905db31565\", \"index\":41, \"name\":\"Gray\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/57.png\", \"motto\":\"Work with full focus\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Reaplicar correções sec07–sec18\", \"type\":\"escritor_tecnico_fsearch\"}, {\"id\":\"1a00e279-3ba2-88bd-8000-0f9074e51636\", \"index\":40, \"name\":\"Faquet\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/56.png\", \"motto\":\"Being seen changes behavior\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Reaplicar correções sec00–sec06\", \"type\":\"escritor_tecnico_fsearch\"}, {\"id\":\"1a00e17c-b8e2-8745-8000-0f90dfb8c9bf\", \"index\":39, \"name\":\"Dewitt\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/55.png\", \"motto\":\"Learning by doing\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Editor de transições global\", \"type\":\"reviewer\"}, {\"id\":\"1a00e0ca-8ec2-81d5-8000-0f90801312be\", \"index\":38, \"name\":\"Picasso\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/54.png\", \"motto\":\"Inspiration exists, but it has to find you working\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Corrigir sec16, sec18 e normalizar citações\", \"type\":\"general\"}, {\"id\":\"1a00e0ca-8de2-8e9