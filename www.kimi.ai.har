            "text": "{\"items\":[{\"type\":\"FEED_TYPE_CHAT\", \"chat\":{\"id\":\"1a00d7be-2872-8e9e-8000-0990fb03a4d3\", \"name\":\"FutureSearch Reversão\", \"files\":[{\"id\":\"1a00d80c-09a2-8f07-8000-0000e7d694c8\", \"meta\":{\"name\":\"2409.14913v2.pdf\", \"contentType\":\"application/pdf\", \"sizeBytes\":\"1215026\", \"checksum\":\"5e932f8e3251afb4d5dc7b9c3df9ddf5740f7dd9d409f2c1fcb58254341b05b4\", \"ext\":\"pdf\", \"createTime\":\"2026-08-17T02:15:36.833367358Z\", \"type\":\"FILE_TYPE_DOCUMENT\"}, \"blob\":{\"signUrl\":\"https://www.kimi.ai/apiv2-files/sign-obj/kimi-fs%2Ffiles%2Fblob%2F5e932f8e3251afb4d5dc7b9c3df9ddf5740f7dd9d409f2c1fcb58254341b05b4?filename=2409.14913v2.pdf&sig=vg_zskDnbGu1lrn65Uov3UU-kiXfZVVMy-6sMLFm5iU=&t=o\", \"previewUrl\":\"https://www.kimi.ai/apiv2-files/sign-obj/kimi-fs%2Ffiles%2Fblob%2F5e932f8e3251afb4d5dc7b9c3df9ddf5740f7dd9d409f2c1fcb58254341b05b4?filename=5e932f.pdf&sig=hgiVyOWjsgn0J7_hnFoZN8Hi0DRn7WZcVt0ODEQ1Tq8=&t=o\"}, \"tokenCount\":\"35619\", \"status\":\"PROCESS_STATUS_SUCCESS\"}, {\"id\":\"1a00d80c-90a2-828b-8000-00001abf1b89\", \"meta\":{\"name\":\"2506.06287v1.pdf\", \"contentType\":\"application/pdf\", \"sizeBytes\":\"4447626\", \"checksum\":\"b77a3aafd7cc2e9b901c61f1a2fc35ea2bab87cc74c85395a4a1050f9f65fe2d\", \"ext\":\"pdf\", \"createTime\":\"2026-08-17T02:15:39.005124608Z\", \"type\":\"FILE_TYPE_DOCUMENT\"}, \"blob\":{\"signUrl\":\"https://www.kimi.ai/apiv2-files/sign-obj/kimi-fs%2Ffiles%2Fblob%2Fb77a3aafd7cc2e9b901c61f1a2fc35ea2bab87cc74c85395a4a1050f9f65fe2d?filename=2506.06287v1.pdf&sig=mOaNDBe0aCFDyfJHSwOfIg7PejMor9cT-GHP1UxtM0I=&t=o\", \"previewUrl\":\"https://www.kimi.ai/apiv2-files/sign-obj/kimi-fs%2Ffiles%2Fblob%2Fb77a3aafd7cc2e9b901c61f1a2fc35ea2bab87cc74c85395a4a1050f9f65fe2d?filename=b77a3a.pdf&sig=qdEorqZpo8XCwUwdoPjW770yiLUiJBg_4jVGqQ7ati0=&t=o\"}, \"tokenCount\":\"20042\", \"status\":\"PROCESS_STATUS_SUCCESS\"}, {\"id\":\"1a00d80c-6e72-802d-8000-00007ee9eecd\", \"meta\":{\"name\":\"2506.21558v1.pdf\", \"co