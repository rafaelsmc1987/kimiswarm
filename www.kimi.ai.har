/41.png\", \"motto\":\"Collaboration turns individual limits into shared strength\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Editar seções 03–05\", \"type\":\"reviewer\"}, {\"id\":\"1a00df9d-8542-8eb1-8000-0f90d7ad03f0\", \"index\":30, \"name\":\"Kat\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/40.png\", \"motto\":\"Aim true\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Editar seções 00–02\", \"type\":\"reviewer\"}, {\"id\":\"1a00df6b-7222-8a53-8000-0f90568036cf\", \"index\":29, \"name\":\"Summer\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/39.png\", \"motto\":\"Efficiency is the soul of doing things well\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Escrever Sumário Executivo\", \"type\":\"escritor_tecnico_fsearch\"}, {\"id\":\"1a00df02-b0c2-8c12-8000-0f90b8e6d901\", \"index\":28, \"name\":\"Wu\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/38.png\", \"motto\":\"The universe doesn't care about our intuition\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Escrever Cap. 12 (Blueprint)\", \"type\":\"escritor_tecnico_fsearch\"}, {\"id\":\"1a00ddb9-f272-8d01-8000-0f9092fd7eeb\", \"index\":27, \"name\":\"Lovel\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/37.png\", \"motto\":\"I shall cross a frontier that no one has yet tried to pass\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Escrever Apêndice E (glossário)\", \"type\":\"escritor_tecnico_fsearch\"}, {\"id\":\"1a00ddb9-f102-8b4e-8000-0f9007f4fb3a\", \"index\":26, \"name\":\"Quentin\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/36.png\", \"motto\":\"Busy with a method, you'll double your output\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Escrever Apêndice D (tabelas consolidadas)\", \"type\":\"escritor_tecnico_fsearch\"}, {\"id\":\"1a00ddb9-f042-8f3c-8000-0f9072942111\", \"index\":25, \"name\":\"Joker\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/35.png\", \"motto\":\"While others follow the path, I blaze a trail\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Escrever Apêndice C (payloads HAR)\", \"type\":\"escritor_tecnico_fsearch\"}, {\"id\":\"1a00ddb9-ef82-86c2-8000-0f906b4c9c8c\", \"index\":24, \"name\":\"Li Hua\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/34.png\", \"motto\":\"Good learners explore principles thoroughly; good practitioners probe difficulties deeply\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Escrever Apêndice B (prompts pipeline)\", \"type\":\"escritor_tecnico_fsearch\"}, {\"id\":\"1a00ddb9-ed72-89d9-8000-0f90976407b0\", \"index\":23, \"name\":\"Rosalind\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/33.png\", \"motto\":\"Whatever is worth doing at all is worth doing well\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Escrever Apêndice A (prompts julgamento)\", \"type\":\"escritor_tecnico_fsearch\"}, {\"id\":\"1a00ddb9-ec72-8307-8000-0f90c43add84\", \"index\":22, \"name\":\"Winton\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/32.png\", \"motto\":\"The limits of my language mean the limits of my world\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Escrever Cap. 11 (Economia/Moat)\", \"type\":\"escritor_tecnico_fsearch\"}, {\"id\":\"1a00ddb9-eb42-8d64-8000-0f9086859f0c\", \"index\":21, \"name\":\"Debussy\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/31.png\", \"motto\":\"Master the silence, and the rest will unfold\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Escrever Cap. 10 (Divergências/World Model)\", \"type\":\"escritor_tecnico_fsearch\"}, {\"id\":\"1a00db5a-7d12-88ce-8000-0f90943586a4\", \"index\":20, \"name\":\"Mok\", \"iconUrl\":\"https://kimi-img.moonshot.cn/pub/okc-agent/30.png\", \"motto\":\"Moving forward with several tasks at once depends on my skills\", \"status\":\"STATUS_TERMINATED\", \"description\":\"Escrever Cap. 9 (Coreografia HAR)\", \"type\":\"escritor_tecnico_fsearch\"}, {\"id\":\"1a00db5a-7bd2-855d