{
  "$defs": {
    "Route": {
      "description": "Research routes R0..R12 (plan \u00a713).",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5",
        "R6",
        "R7",
        "R8",
        "R9",
        "R10",
        "R11",
        "R12"
      ],
      "title": "Route",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Raw user request captured at intake, before any interpretation.",
  "properties": {
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "objective": {
      "title": "Objective",
      "type": "string"
    },
    "decision_context": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision Context"
    },
    "audience": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audience"
    },
    "submitted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submitted At"
    },
    "attachments": {
      "items": {
        "type": "string"
      },
      "title": "Attachments",
      "type": "array"
    },
    "requested_route": {
      "anyOf": [
        {
          "$ref": "#/$defs/Route"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "user_constraints": {
      "additionalProperties": true,
      "title": "User Constraints",
      "type": "object"
    }
  },
  "required": [
    "request_id",
    "objective"
  ],
  "title": "ResearchRequest",
  "type": "object"
}
