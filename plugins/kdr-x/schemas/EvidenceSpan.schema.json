{
  "$defs": {
    "EvidenceType": {
      "enum": [
        "verbatim",
        "table",
        "figure",
        "number",
        "definition",
        "method",
        "result"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "Locator": {
      "additionalProperties": false,
      "description": "A precise position inside a source (page/section/paragraph/table/line...).",
      "properties": {
        "type": {
          "default": "locator",
          "title": "Type",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "paragraph": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph"
        },
        "table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "figure": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Figure"
        },
        "line_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "line_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "char_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "char_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "uri_fragment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri Fragment"
        }
      },
      "title": "Locator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The minimum unit of evidence: an exact, locatable span (plan \u00a721).\n\nExact verbatim spans are kept separate from summaries on purpose \u2014 a\nnormalized proposition may paraphrase, but ``verbatim_span`` must be the\nliteral text (or a literal table/number) as it appears in the source.",
  "properties": {
    "evidence_id": {
      "title": "Evidence Id",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "locator": {
      "$ref": "#/$defs/Locator"
    },
    "verbatim_span": {
      "default": "",
      "title": "Verbatim Span",
      "type": "string"
    },
    "normalized_proposition": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Normalized Proposition"
    },
    "evidence_type": {
      "$ref": "#/$defs/EvidenceType",
      "default": "verbatim"
    },
    "extraction_method": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extraction Method"
    },
    "extractor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extractor"
    },
    "verified": {
      "default": false,
      "title": "Verified",
      "type": "boolean"
    },
    "content_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Hash"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "evidence_id",
    "source_id"
  ],
  "title": "EvidenceSpan",
  "type": "object"
}
