{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "report",
        "docx",
        "pdf",
        "site",
        "table",
        "figure",
        "dataset",
        "script",
        "manifest"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "SealLevel": {
      "description": "Provenance seal levels (Orchestra ARA-inspired).",
      "enum": [
        "none",
        "level_1_hashed",
        "level_2_signed",
        "level_3_reproducible"
      ],
      "title": "SealLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One persisted artifact with provenance and a seal.",
  "properties": {
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ArtifactKind"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "content_hash": {
      "title": "Content Hash",
      "type": "string"
    },
    "seal_level": {
      "$ref": "#/$defs/SealLevel",
      "default": "level_1_hashed"
    },
    "produced_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Produced By"
    },
    "produced_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Produced At"
    },
    "inputs": {
      "items": {
        "type": "string"
      },
      "title": "Inputs",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "artifact_id",
    "kind",
    "path",
    "content_hash"
  ],
  "title": "ArtifactRecord",
  "type": "object"
}
