#!/usr/bin/env python3
"""KDR-X hook shim — dev/debug entry point only.

The harness path is the exec form ``kdr hook --stdin <event>`` (hooks.json),
dispatched through the pip-installed ``kdr`` entry point. This shim exists so
tests and developers can invoke the dispatcher directly from a checkout,
without installing the package:

    python plugins/kdr-x/hooks/kdr-hook <event>     (payload via stdin)

Import bootstrap priority: ``$KDRX_SRC`` -> monorepo layout (``<repo>/src``
detected relative to this file) -> plain ``import kdrx`` (installed package).
Failure prints a JSON error and exits 2.
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path

_KDRX_SRC = os.environ.get("KDRX_SRC")
if _KDRX_SRC:
    sys.path.insert(0, _KDRX_SRC)
else:
    _MONOREPO_SRC = Path(__file__).resolve().parents[3] / "src"
    if (_MONOREPO_SRC / "kdrx").is_dir():
        sys.path.insert(0, str(_MONOREPO_SRC))

try:
    from kdrx.hook_dispatch import main
except ImportError as exc:
    print(json.dumps({"error": f"kdrx not importable: {exc}"}))
    raise SystemExit(2) from exc

if __name__ == "__main__":
    raise SystemExit(main())
